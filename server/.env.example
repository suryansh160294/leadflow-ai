# ============================================
#  LeadFlow AI — Environment Variables
#  Copy this file to .env and fill in values
# ============================================

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test

# ── PostgreSQL ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadflow_dev
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false                  # set to true in production

# ── JWT ───────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_long_random_string_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────
CORS_ORIGIN=http://localhost:5173   # your frontend URL

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000         # 15 minutes
RATE_LIMIT_MAX=100                  # requests per window

# ── Twilio (WhatsApp) — Phase 2 ───────────────
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── n8n Webhook URL — Phase 2 ─────────────────
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-assigned
